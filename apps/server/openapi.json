  "info": {
    "title": "Weave API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "PageSummaryDto": {
        "type": "object",
        "properties": {
          "blockCount": {
            "type": "number"
          },
          "refCount": {
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "starred": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "blockCount",
          "refCount",
          "id",
          "title",
          "starred",
          "createdAt",
          "updatedAt"
        ]
      },
      "PageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "starred": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "starred",
          "createdAt",
          "updatedAt"
        ]
      },
      "BlockDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pageId": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "type": "number"
          },
          "content": {
            "type": "string"
          },
          "open": {
            "type": "boolean"
          },
          "refCount": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "pageId",
          "parentId",
          "position",
          "content",
          "open",
          "refCount"
        ]
      },
      "PageDetailDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "page": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PageDto"
              }
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlockDto"
            }
          }
        },
        "required": [
          "title",
          "page",
          "blocks"
        ]
      },
      "BreadcrumbDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content"
        ]
      },
      "ReferenceItemDto": {
        "type": "object",
        "properties": {
          "block": {
            "$ref": "#/components/schemas/BlockDto"
          },
          "breadcrumbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BreadcrumbDto"
            }
          }
        },
        "required": [
          "block",
          "breadcrumbs"
        ]
      },
      "ReferenceGroupDto": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string"
          },
          "pageTitle": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceItemDto"
            }
          }
        },
        "required": [
          "pageId",
          "pageTitle",
          "items"
        ]
      },
      "ReferencesDto": {
        "type": "object",
        "properties": {
          "linked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceGroupDto"
            }
          },
          "unlinked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReferenceGroupDto"
            }
          }
        },
        "required": [
          "linked",
          "unlinked"
        ]
      },
      "CreatePageDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdatePageDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "starred": {
            "type": "boolean"
          }
        }
      },
      "BlockRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pageId": {
            "type": "string"
          },
          "pageTitle": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "pageId",
          "pageTitle",
          "content"
        ]
      },
      "CreateBlockDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pageId": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "index": {
            "type": "number",
            "minimum": 0
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "pageId"
        ]
      },
      "UpdateBlockDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 20000
          },
          "open": {
            "type": "boolean"
          }
        }
      },
      "MoveBlockDto": {
        "type": "object",
